"""Execute the packaged fragment in GLES and inspect the numeric framebuffer."""
import ctypes as ABI
import re
import struct
from builtins import AssertionError, SystemExit, all, getattr, list, map, max, set, setattr, sorted
from math import hypot, isfinite
from pathlib import Path
from types import SimpleNamespace

ROOT ∈ object ← Path(__file__).resolve().parent.parent.parent
GL_SHADER_SOURCE ∈ str ← """#version 300 es
out vec2 v_ndc;
void main() {
    v_ndc = vec2(gl_VertexID == 1 ? 3.0 : -1.0, gl_VertexID == 2 ? 3.0 : -1.0);
    gl_Position = vec4(v_ndc, 0.0, 1.0);
}
"""
PROBE ∈ str ← """
uniform vec2 u_probe_s;
void main() {
    vec2 value;
    bool accepted = evaluate_l(u_object, u_probe_s, value);
    frag_color = vec4(value, 0.0, accepted ? 1.0 : 0.0);
}
"""

def require(condition ∈ bool, message ∈ str) → None:
    if not condition:
        raise AssertionError(message)

def bind_egl(library ∈ object, name ∈ str, result ∈ object, arguments ∈ list[object]) → None:
    function ∈ object ← getattr(library, name)
    setattr(function, "restype", result)
    setattr(function, "argtypes", arguments)

def bind_gl(gl ∈ object, library ∈ object, name ∈ str, result ∈ object,
            arguments ∈ list[object]) → None:
    address ∈ object ← library.eglGetProcAddress(name.encode())
    require(bool(address), "Missing GLES function " + name)
    function ∈ object ← ABI.cast(address, ABI.CFUNCTYPE(result))
    setattr(function, "argtypes", arguments)
    setattr(gl, name, function)

def open_context() → object:
    egl ∈ object ← ABI.CDLL("libEGL.so.1")
    pointer ∈ object ← ABI.c_void_p
    integer ∈ object ← ABI.c_int
    uint ∈ object ← ABI.c_uint
    integer_pointer ∈ object ← ABI.POINTER(integer)
    bind_egl(egl, "eglGetDisplay", pointer, [pointer])
    bind_egl(egl, "eglInitialize", uint, [pointer, integer_pointer, integer_pointer])
    bind_egl(egl, "eglBindAPI", uint, [uint])
    bind_egl(egl, "eglChooseConfig", uint, [pointer, integer_pointer, pointer, integer, integer_pointer])
    bind_egl(egl, "eglCreateContext", pointer, [pointer, pointer, pointer, integer_pointer])
    bind_egl(egl, "eglMakeCurrent", uint, [pointer, pointer, pointer, pointer])
    bind_egl(egl, "eglGetProcAddress", pointer, [ABI.c_char_p])
    display ∈ object ← egl.eglGetDisplay(None)
    require(bool(egl.eglInitialize(display, None, None)), "Cannot initialize EGL")
    require(bool(egl.eglBindAPI(0x30A0)), "Cannot bind OpenGL ES")
    # EGL_SURFACE_TYPE=PBUFFER_BIT, EGL_RENDERABLE_TYPE=OPENGL_ES3_BIT.
    attributes ∈ object ← ABI.cast(struct.pack("5i", 0x3033, 1, 0x3040, 0x40, 0x3038), integer_pointer)
    config ∈ object ← ABI.c_void_p()
    count ∈ object ← ABI.c_int()
    chosen ∈ int ← egl.eglChooseConfig(display, attributes, ABI.byref(config), 1, ABI.byref(count))
    require(chosen == 1 and int(count.value) == 1, "No GLES 3 EGL configuration")
    context_attributes ∈ object ← ABI.cast(struct.pack("3i", 0x3098, 3, 0x3038), integer_pointer)
    context ∈ object ← egl.eglCreateContext(display, config, None, context_attributes)
    require(bool(context), "Cannot create GLES 3 context")
    require(bool(egl.eglMakeCurrent(display, None, None, context)), "Cannot bind surfaceless GLES 3")
    return egl

def functions(egl ∈ object) → object:
    gl ∈ object ← SimpleNamespace()
    unsigned ∈ object ← ABI.c_uint
    integer ∈ object ← ABI.c_int
    number ∈ object ← ABI.c_float
    pointer ∈ object ← ABI.c_void_p
    text ∈ object ← ABI.c_char_p
    integer_pointer ∈ object ← ABI.POINTER(integer)
    no_arguments ∈ list[object] ← []
    bind_gl(gl, egl, "glGetError", unsigned, no_arguments)
    bind_gl(gl, egl, "glGetString", text, [unsigned])
    bind_gl(gl, egl, "glGetShaderPrecisionFormat", None, [unsigned, unsigned, integer_pointer, integer_pointer])
    bind_gl(gl, egl, "glCreateShader", unsigned, [unsigned])
    bind_gl(gl, egl, "glShaderSource", None, [unsigned, integer, ABI.POINTER(text), integer_pointer])
    bind_gl(gl, egl, "glCompileShader", None, [unsigned])
    bind_gl(gl, egl, "glGetShaderiv", None, [unsigned, unsigned, integer_pointer])
    bind_gl(gl, egl, "glGetShaderInfoLog", None, [unsigned, integer, integer_pointer, pointer])
    bind_gl(gl, egl, "glCreateProgram", unsigned, no_arguments)
    bind_gl(gl, egl, "glAttachShader", None, [unsigned, unsigned])
    bind_gl(gl, egl, "glLinkProgram", None, [unsigned])
    bind_gl(gl, egl, "glGetProgramiv", None, [unsigned, unsigned, integer_pointer])
    bind_gl(gl, egl, "glGetProgramInfoLog", None, [unsigned, integer, integer_pointer, pointer])
    bind_gl(gl, egl, "glDeleteShader", None, [unsigned])
    bind_gl(gl, egl, "glDeleteProgram", None, [unsigned])
    bind_gl(gl, egl, "glUseProgram", None, [unsigned])
    bind_gl(gl, egl, "glGetUniformLocation", integer, [unsigned, text])
    bind_gl(gl, egl, "glUniform1i", None, [integer, integer])
    bind_gl(gl, egl, "glUniform1f", None, [integer, number])
    bind_gl(gl, egl, "glUniform2f", None, [integer, number, number])
    bind_gl(gl, egl, "glGenTextures", None, [integer, ABI.POINTER(unsigned)])
    bind_gl(gl, egl, "glBindTexture", None, [unsigned, unsigned])
    bind_gl(gl, egl, "glTexStorage2D", None, [unsigned, integer, unsigned, integer, integer])
    bind_gl(gl, egl, "glGenFramebuffers", None, [integer, ABI.POINTER(unsigned)])
    bind_gl(gl, egl, "glBindFramebuffer", None, [unsigned, unsigned])
    bind_gl(gl, egl, "glFramebufferTexture2D", None, [unsigned, unsigned, unsigned, unsigned, integer])
    bind_gl(gl, egl, "glCheckFramebufferStatus", unsigned, [unsigned])
    bind_gl(gl, egl, "glViewport", None, [integer, integer, integer, integer])
    bind_gl(gl, egl, "glDrawArrays", None, [unsigned, integer, integer])
    bind_gl(gl, egl, "glReadPixels", None, [integer, integer, integer, integer, unsigned, unsigned, pointer])
    return gl

def compile_shader(gl ∈ object, stage ∈ int, source ∈ str) → int:
    shader ∈ int ← gl.glCreateShader(stage)
    data ∈ object ← ABI.c_char_p(source.encode("utf-8"))
    gl.glShaderSource(shader, 1, ABI.byref(data), None)
    gl.glCompileShader(shader)
    status ∈ object ← ABI.c_int()
    gl.glGetShaderiv(shader, 0x8B81, ABI.byref(status))
    if int(status.value) != 1:
        log ∈ object ← ABI.create_string_buffer(8192)
        gl.glGetShaderInfoLog(shader, 8192, None, log)
        raise AssertionError("GLSL compile: " + str(log.value.decode()))
    return shader

def program_for(gl ∈ object, vertex ∈ int, source ∈ str) → int:
    fragment ∈ int ← compile_shader(gl, 0x8B30, source)
    program ∈ int ← gl.glCreateProgram()
    gl.glAttachShader(program, vertex)
    gl.glAttachShader(program, fragment)
    gl.glLinkProgram(program)
    status ∈ object ← ABI.c_int()
    gl.glGetProgramiv(program, 0x8B82, ABI.byref(status))
    if int(status.value) != 1:
        log ∈ object ← ABI.create_string_buffer(8192)
        gl.glGetProgramInfoLog(program, 8192, None, log)
        raise AssertionError("GLSL link: " + str(log.value.decode()))
    gl.glDeleteShader(fragment)
    gl.glUseProgram(program)
    return program

def prepare_framebuffer(gl ∈ object) → None:
    precision ∈ object ← ABI.c_int()
    range_values ∈ object ← ABI.cast(ABI.create_string_buffer(8), ABI.POINTER(ABI.c_int))
    gl.glGetShaderPrecisionFormat(0x8B30, 0x8DF2, range_values, ABI.byref(precision))
    require(int(precision.value) >= 23, "Fragment highp has fewer than 23 fraction bits")
    texture ∈ object ← ABI.c_uint()
    gl.glGenTextures(1, ABI.byref(texture))
    gl.glBindTexture(0x0DE1, texture)
    gl.glTexStorage2D(0x0DE1, 1, 0x8814, 1, 1)  # RGBA32F
    framebuffer ∈ object ← ABI.c_uint()
    gl.glGenFramebuffers(1, ABI.byref(framebuffer))
    gl.glBindFramebuffer(0x8D40, framebuffer)
    gl.glFramebufferTexture2D(0x8D40, 0x8CE0, 0x0DE1, texture, 0)
    require(int(gl.glCheckFramebufferStatus(0x8D40)) == 0x8CD5, "RGBA32F framebuffer incomplete")
    gl.glViewport(0, 0, 1, 1)

def location(gl ∈ object, program ∈ int, name ∈ str) → int:
    uniform ∈ int ← gl.glGetUniformLocation(program, name.encode())
    require(uniform >= 0, "Missing uniform " + name)
    return uniform

def draw(gl ∈ object) → list[float]:
    pixel ∈ object ← ABI.create_string_buffer(16)
    gl.glDrawArrays(4, 0, 3)  # TRIANGLES
    gl.glReadPixels(0, 0, 1, 1, 0x1908, 0x1406, pixel)  # RGBA, FLOAT
    require(int(gl.glGetError()) == 0, "GLES draw or float readback failed")
    return list(struct.unpack("4f", pixel.raw))

def check_packaged(gl ∈ object, vertex ∈ int, source ∈ str) → None:
    program ∈ int ← program_for(gl, vertex, source)
    gl.glUniform2f(location(gl, program, "u_center"), 1, 0)
    gl.glUniform1f(location(gl, program, "u_half_height"), 0)
    gl.glUniform1f(location(gl, program, "u_aspect"), 1)
    object_uniform ∈ int ← location(gl, program, "u_object")
    for character in range(3):
        gl.glUniform1i(object_uniform, character)
        colors ∈ list[float] ← draw(gl)
        require(colors[3] == 1 and float(max(colors[:3])) > 0, "Blank portrait for character " + str(character))
    gl.glUniform1i(object_uniform, 3)
    require(draw(gl) == [0.0, 0.0, 0.0, 1.0], "Packaged shader accepted unsupported identity")
    gl.glDeleteProgram(program)

def replace_one(source ∈ str, original ∈ str, replacement ∈ str) → str:
    require(int(source.count(original)) == 1, "Unexpected mutation site count: " + original)
    return source.replace(original, replacement)

def direct_dispatch(source ∈ str) → bool:
    code ∈ str ← re.sub(r"/\*[\s\S]*?\*/|//[^\n]*", "", source)
    body ∈ object ← re.search(r"bool evaluate_l\([^)]*\)\s*\{([\s\S]*?)^\}", code, re.M)
    require(bool(body), "Missing evaluate_l dispatcher")
    calls ∈ list[tuple[str, str]] ← re.findall(r"\bevaluate_chi([345])\(([^)]*)\)", body.group(1))
    direct ∈ list[str] ← []
    for call in calls:
        require(len(call) == 2, "Malformed dispatcher match")
        if str(call[1].strip()) == "s":
            direct.append(call[0])
    ordered ∈ list[str] ← sorted(direct)
    return len(direct) == 3 and len(calls) == 3 and ordered == ["3", "4", "5"]

def compare(gl ∈ object, vertex ∈ int, source ∈ str, rows ∈ list[str],
            verify_rejections ∈ bool) → int:
    instrumented ∈ str ← replace_one(source, "void main() {", "void app_main() {") + PROBE
    program ∈ int ← program_for(gl, vertex, instrumented)
    object_uniform ∈ int ← location(gl, program, "u_object")
    input_uniform ∈ int ← location(gl, program, "u_probe_s")
    maxima ∈ list[float] ← [0.0, 0.0, 0.0]
    failure_count ∈ int ← 0
    for row in rows:
        fields ∈ list[str] ← row.split("\t")
        require(len(fields) == 6, "Invalid reference row: " + row)
        character ∈ int ← int(fields[1])
        real ∈ float ← float(fields[2])
        imaginary ∈ float ← float(fields[3])
        expected_real ∈ float ← float(fields[4])
        expected_imaginary ∈ float ← float(fields[5])
        require(0 <= character <= 2 and bool(all(map(isfinite, [real, imaginary, expected_real, expected_imaginary]))),
                "Invalid reference coordinate or result: " + row)
        gl.glUniform1i(object_uniform, character)
        gl.glUniform2f(input_uniform, real, imaginary)
        observed ∈ list[float] ← draw(gl)
        error ∈ float ← hypot(observed[0] - expected_real, observed[1] - expected_imaginary)
        budget ∈ float ← 2e-5 + 2e-5 * float(hypot(expected_real, expected_imaginary))
        if observed[3] != 1 or not bool(isfinite(error)) or error > budget:
            failure_count ← failure_count + 1
            if verify_rejections:
                print("FAIL", fields[0], character, error, budget, observed)
        # insert and pop preserve the typed list boundary.
        maxima.insert(character, float(max(error, maxima.pop(character))))
    if verify_rejections:
        invalid ∈ list[tuple[int, float, float]] ← [
            (-1, 1.0, 0.0), (3, 1.0, 0.0), (0, float("nan"), 0.0),
            (1, 1.0, float("nan")), (2, float("inf"), 0.0), (2, 1.0, -float("inf"))]
        for invalid_input in invalid:
            gl.glUniform1i(object_uniform, invalid_input[0])
            gl.glUniform2f(input_uniform, invalid_input[1], invalid_input[2])
            require(draw(gl) == [0.0, 0.0, 0.0, 0.0], "Accepted invalid input " + str(invalid_input))
        print("Maximum absolute complex errors by conductor (3, 4, 5):", maxima)
        print(len(invalid), "invalid evaluator inputs rejected")
    gl.glDeleteProgram(program)
    return failure_count

def main() → int:
    source ∈ str ← ROOT.joinpath("app", "src", "main", "assets", "l-wegert.frag").read_text()
    reference ∈ str ← ROOT.joinpath("ci", "l-at-one", "reference.tsv").read_text()
    rows ∈ list[str] ← reference.splitlines()
    header ∈ str ← rows.pop(0)
    require(header == "point\tobject\ts_real\ts_imag\tl_real\tl_imag", "Wrong reference schema")
    keys ∈ list[str] ← []
    for row in rows:
        fields ∈ list[str] ← row.split("\t")
        require(len(fields) == 6, "Invalid reference row")
        keys.append(fields[1] + "/" + fields[2] + "/" + fields[3])
    require(len(rows) == 186 and len(set(keys)) == len(rows), "Wrong reference coverage")
    gl ∈ object ← functions(open_context())
    print(gl.glGetString(0x1F01).decode(), gl.glGetString(0x1F02).decode())
    prepare_framebuffer(gl)
    vertex ∈ int ← compile_shader(gl, 0x8B31, GL_SHADER_SOURCE)
    check_packaged(gl, vertex, source)
    print("Unmodified packaged shader compiled, linked and drew three portraits")
    require(direct_dispatch(source), "The evaluator must dispatch the original coordinate")
    require(compare(gl, vertex, source, rows, True) == 0, "Binary32 accuracy budget exceeded")
    mutations ∈ list[tuple[str, str, str]] ← [
        ("uncancelled residue", "value += regular_tail(s - vec2(1.0, 0.0), tail);",
         "value += c_div(positive_base_power(tail, vec2(1.0, 0.0) - s), s - vec2(1.0, 0.0));"),
        ("wrong character sign", "- hurwitz_zeta_regular(s, 2.0 / 3.0);",
         "+ hurwitz_zeta_regular(s, 2.0 / 3.0);"),
        ("wrong conductor factor", "positive_base_power(5.0, -s), residues",
         "positive_base_power(4.0, -s), residues"),
    ]
    for mutation in mutations:
        mutant ∈ str ← replace_one(source, mutation[1], mutation[2])
        failures ∈ int ← compare(gl, vertex, mutant, rows, False)
        require(failures > 0, "Undetected mutation: " + str(mutation[0]))
        print("Rejected", mutation[0], "with", failures, "failing comparisons")
    offset ∈ str ← replace_one(source, "if (object_index == 0) value = evaluate_chi3(s);",
        """if (object_index == 0) value = distance(s, vec2(1.0, 0.0)) < 0.003
            ? 0.5 * (evaluate_chi3(s - vec2(0.004, 0.0)) + evaluate_chi3(s + vec2(0.004, 0.0)))
            : evaluate_chi3(s);""")
    require(not direct_dispatch(offset), "Undetected mutation: offset averaging")
    print("Rejected offset averaging by the direct-coordinate dispatch check")
    print("PASS", len(rows), "F32 GLSL comparisons")
    return 0

raise SystemExit(main())
